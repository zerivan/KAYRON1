using System.Text.Json;
using KAYRON.Core;
using Microsoft.Extensions.Logging;

namespace KAYRON.Engine;

public sealed class Orquestrador : IOrquestrador
{
    private const int MaximoCiclos = 6;

    private readonly IDecisor _decisor;
    private readonly IDetectorIntencao _detectorIntencao;
    private readonly ICatalogoFerramentas _catalogoFerramentas;
    private readonly ExecutorFerramentas _executorFerramentas;
    private readonly DispatcherComandos _dispatcher;
    private readonly ILogger<Orquestrador> _logger;

    public Orquestrador(
        IDecisor decisor,
        IDetectorIntencao detectorIntencao,
        ICatalogoFerramentas catalogoFerramentas,
        ExecutorFerramentas executorFerramentas,
        DispatcherComandos dispatcher,
        ILogger<Orquestrador> logger)
    {
        ArgumentNullException.ThrowIfNull(decisor);
        ArgumentNullException.ThrowIfNull(detectorIntencao);
        ArgumentNullException.ThrowIfNull(catalogoFerramentas);
        ArgumentNullException.ThrowIfNull(executorFerramentas);
        ArgumentNullException.ThrowIfNull(dispatcher);
        ArgumentNullException.ThrowIfNull(logger);

        _decisor = decisor;
        _detectorIntencao = detectorIntencao;
        _catalogoFerramentas = catalogoFerramentas;
        _executorFerramentas = executorFerramentas;
        _dispatcher = dispatcher;
        _logger = logger;
    }

    public async Task<Resposta> ProcessarAsync(
        Instrucao instrucao,
        IContexto contexto,
        CancellationToken cancellationToken = default)
    {
        ArgumentNullException.ThrowIfNull(instrucao);
        ArgumentNullException.ThrowIfNull(contexto);

        cancellationToken.ThrowIfCancellationRequested();

        var entrada = instrucao.Conteudo.Trim();

        if (string.IsNullOrWhiteSpace(entrada))
        {
            return new Resposta
            {
                Conteudo = "KAYRON não recebeu uma instrução."
            };
        }

        _logger.LogInformation(
            "Iniciando ciclo cognitivo para: {Entrada}",
            entrada);

        if (entrada.StartsWith("/"))
        {
            return ProcessarComando(
                entrada,
                contexto);
        }

        contexto.Adicionar(
            "ciclo:objetivo",
            entrada);

        for (var ciclo = 1; ciclo <= MaximoCiclos; ciclo++)
        {
            cancellationToken.ThrowIfCancellationRequested();

            contexto.Adicionar(
                "ciclo:numero",
                ciclo.ToString());

            _logger.LogInformation(
                "Ciclo cognitivo {Ciclo}/{Maximo}.",
                ciclo,
                MaximoCiclos);

            await _decisor.DecidirAsync(
                new Instrucao
                {
                    Conteudo = entrada
                },
                contexto,
                cancellationToken);

            var intencao =
                _detectorIntencao.Detectar(
                    entrada,
                    contexto);

            contexto.Adicionar(
                "ciclo:intencao",
                intencao.Operacao);

            if (!intencao.Identificada)
            {
                var ferramenta =
                    IdentificarFerramenta(
                        entrada);

                if (ferramenta is null)
                {
                    return ResponderComContexto(
                        entrada,
                        contexto);
                }

                intencao = new IntencaoDetectada
                {
                    Ferramenta = ferramenta.Nome,
                    Operacao = IdentificarOperacao(
                        entrada,
                        ferramenta.Nome),
                    Confianca = 0.50,
                    Identificada = true,
                    Evidencia = "descoberta local de capacidade"
                };
            }

            var resultado =
                await ExecutarIntencaoInterna(
                    entrada,
                    intencao,
                    contexto,
                    cancellationToken);

            contexto.Adicionar(
                "ciclo:resultado",
                resultado.Conteudo);

            _logger.LogInformation(
                "Observação recebida no ciclo {Ciclo}: {Resultado}",
                ciclo,
                resultado.Conteudo);

            if (resultado.Conteudo.StartsWith(
                    "ERRO:",
                    StringComparison.OrdinalIgnoreCase))
            {
                return resultado;
            }

            /*
             * O resultado da ferramenta é uma observação.
             * Ele volta ao contexto para ser considerado
             * pelo próximo ciclo de decisão.
             */
            contexto.Adicionar(
                "decisao:observacao",
                resultado.Conteudo);

            contexto.Adicionar(
                "decisao:ciclo_anterior",
                ciclo.ToString());

            /*
             * A execução não é automaticamente a resposta final.
             * O próximo ciclo deve decidir o que fazer com a
             * observação recebida.
             */
            if (ciclo < MaximoCiclos)
            {
                contexto.Adicionar(
                    "decisao:continuar",
                    "true");

                continue;
            }

            return new Resposta
            {
                Conteudo =
                    string.IsNullOrWhiteSpace(resultado.Conteudo)
                        ? "A execução foi concluída."
                        : resultado.Conteudo
            };
        }

        return new Resposta
        {
            Conteudo =
                "KAYRON interrompeu o ciclo porque atingiu o limite seguro de decisões."
        };
    }

    private Resposta ProcessarComando(
        string entrada,
        IContexto contexto)
    {
        var partes =
            entrada[1..]
                .Split(
                    ' ',
                    2,
                    StringSplitOptions.RemoveEmptyEntries);

        if (partes.Length == 0)
        {
            return new Resposta
            {
                Conteudo = "Comando vazio."
            };
        }

        var nome =
            partes[0].Trim();

        var argumentos =
            partes.Length > 1
                ? partes[1].Trim()
                : string.Empty;

        var comando =
            _dispatcher.Obter(nome);

        if (comando is null)
        {
            return new Resposta
            {
                Conteudo =
                    $"KAYRON não reconhece o comando: /{nome}"
            };
        }

        contexto.Adicionar(
            "comando:nome",
            nome);

        contexto.Adicionar(
            "comando:argumentos",
            argumentos);

        return comando.Executar(
            argumentos,
            contexto);
    }

    public async Task<Resposta> ProcessarIntencaoAsync(
        Instrucao instrucao,
        IContexto contexto,
        IntencaoDetectada intencao,
        CancellationToken cancellationToken = default)
    {
        ArgumentNullException.ThrowIfNull(instrucao);
        ArgumentNullException.ThrowIfNull(contexto);
        ArgumentNullException.ThrowIfNull(intencao);

        cancellationToken.ThrowIfCancellationRequested();

        var entrada = instrucao.Conteudo.Trim();

        if (string.IsNullOrWhiteSpace(entrada))
        {
            return new Resposta
            {
                Conteudo = "KAYRON não recebeu uma instrução."
            };
        }

        return await ExecutarIntencaoInterna(
            entrada,
            intencao,
            contexto,
            cancellationToken);
    }

    private async Task<Resposta> ExecutarIntencaoInterna(
        string entrada,
        IntencaoDetectada intencao,
        IContexto contexto,
        CancellationToken cancellationToken)
    {
        var ferramenta =
            _catalogoFerramentas.Obter(
                intencao.Ferramenta);

        if (ferramenta is null)
        {
            return new Resposta
            {
                Conteudo =
                    $"KAYRON identificou a operação '{intencao.Operacao}', mas a capacidade '{intencao.Ferramenta}' não está disponível."
            };
        }

        contexto.Adicionar(
            "execucao:ferramenta",
            ferramenta.Nome);

        contexto.Adicionar(
            "execucao:operacao",
            intencao.Operacao);

        var argumentos =
            ExtrairArgumentos(
                entrada,
                ferramenta.Nome);

        var resultado =
            await _executorFerramentas.ExecutarAsync(
                ferramenta.Nome,
                argumentos,
                contexto,
                cancellationToken,
                intencao.Operacao);

        contexto.Adicionar(
            "execucao:resultado",
            JsonSerializer.Serialize(resultado));

        return new Resposta
        {
            Conteudo =
                JsonSerializer.Serialize(resultado)
        };
    }
    private IFerramenta? IdentificarFerramenta(
        string entrada)
    {
        IFerramenta? melhor = null;
        var maiorPontuacao = 0;

        foreach (var ferramenta in
                 _catalogoFerramentas.Listar())
        {
            var pontuacao =
                Pontuar(
                    entrada,
                    ferramenta);

            if (pontuacao > maiorPontuacao)
            {
                maiorPontuacao = pontuacao;
                melhor = ferramenta;
            }
        }

        return melhor;
    }

    private static int Pontuar(
        string entrada,
        IFerramenta ferramenta)
    {
        var texto =
            entrada.ToLowerInvariant();

        var pontos = 0;

        if (texto.Contains(
                ferramenta.Nome.ToLowerInvariant(),
                StringComparison.Ordinal))
        {
            pontos += 100;
        }

        foreach (var termo in
                 ferramenta.Descricao
                     .Split(
                         ' ',
                         StringSplitOptions.RemoveEmptyEntries))
        {
            var limpo =
                termo
                    .Trim(
                        '.',
                        ',',
                        ';',
                        ':',
                        '(',
                        ')')
                    .ToLowerInvariant();

            if (limpo.Length >= 4 &&
                texto.Contains(
                    limpo,
                    StringComparison.Ordinal))
            {
                pontos += 2;
            }
        }

        return pontos;
    }

    private static string IdentificarOperacao(
        string entrada,
        string ferramenta)
    {
        var texto =
            entrada.ToLowerInvariant();

        if (texto.Contains("corrija") ||
            texto.Contains("corrigir") ||
            texto.Contains("correja"))
        {
            return "autocorrigir";
        }

        if (texto.Contains("analise") ||
            texto.Contains("diagnostique") ||
            texto.Contains("diagnosticar"))
        {
            return "diagnosticar";
        }

        if (texto.Contains("liste") ||
            texto.Contains("listar"))
        {
            return "listar";
        }

        if (texto.Contains("leia") ||
            texto.Contains("ler"))
        {
            return "ler";
        }

        if (texto.Contains("abra") ||
            texto.Contains("abrir"))
        {
            return "abrir";
        }

        return ferramenta;
    }

    private static string ExtrairArgumentos(
        string entrada,
        string ferramenta)
    {
        var texto =
            entrada.Trim();

        var indice =
            texto.IndexOf(
                ferramenta,
                StringComparison.OrdinalIgnoreCase);

        if (indice >= 0)
        {
            return texto[
                (indice + ferramenta.Length)..]
                .Trim();
        }

        return texto;
    }

    private static Resposta ResponderComContexto(
        string entrada,
        IContexto contexto)
    {
        var memoria =
            contexto.Obter(
                "decisao:memoria:valor");

        if (!string.IsNullOrWhiteSpace(memoria))
        {
            return new Resposta
            {
                Conteudo =
                    $"Com base no contexto disponível: {memoria}"
            };
        }

        return new Resposta
        {
            Conteudo =
                "Entendi a solicitação, mas ainda preciso de mais contexto para determinar a ação correta."
        };
    }
}


