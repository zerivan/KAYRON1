<Window x:Class="KAYRON.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KAYRON" Width="1180" Height="780" MinWidth="520" MinHeight="480"
        WindowStartupLocation="CenterScreen" Background="{StaticResource BgBrush}"
        SizeChanged="Window_SizeChanged"
        Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Margin" Value="4,2"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style x:Key="SendButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="HistoryButton" TargetType="Button" BasedOn="{StaticResource NavButton}">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="2,1"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="MinWidth" Value="6"/>
            <Setter Property="MaxWidth" Value="6"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.Background>
            <RadialGradientBrush Center="0.82,0.48" RadiusX="0.72" RadiusY="0.72">
                <GradientStop Color="#26113D" Offset="0"/>
                <GradientStop Color="#100B15" Offset="0.48"/>
                <GradientStop Color="#080609" Offset="1"/>
            </RadialGradientBrush>
        </Grid.Background>

        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="260" MinWidth="0" MaxWidth="260"/>
            <ColumnDefinition Width="18"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border x:Name="SidebarBorder" Grid.Column="0"
                Background="{StaticResource SidebarBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                CornerRadius="10" Opacity="0.97">
            <Grid Margin="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="4,4,4,18" x:Name="SidebarHeader">
                    <StackPanel Orientation="Horizontal">
                <Border x:Name="BrandMark" Width="38" Height="38" CornerRadius="11"
                                Background="{StaticResource AccentBrush}" Margin="0,0,11,0">
                            <TextBlock Text="K" FontSize="21" FontWeight="Bold" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Foreground="White"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="KAYRON" FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock Text="AI Engineering Agent" FontSize="10"
                                       Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <ScrollViewer x:Name="ConversationScroll" Grid.Row="1" VerticalScrollBarVisibility="Visible"
                              HorizontalScrollBarVisibility="Disabled" Margin="0,10,0,10">
                    <StackPanel>
                        <TextBlock Text="CHAT RECENTE" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentSoftBrush}" Margin="12,12,12,8"/>
                        <StackPanel x:Name="HistoryList"/>
                    </StackPanel>
                </ScrollViewer>

                <TextBlock x:Name="StatusPanel" Grid.Row="2" Text="CONFIGURAÇÕES" FontSize="10" FontWeight="SemiBold"
                           Foreground="{StaticResource AccentSoftBrush}" Margin="12,6,12,8"/>

                <StackPanel Grid.Row="3">
                    <Button x:Name="NewChatButton" Style="{StaticResource NavButton}"
                            Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                            Click="NovaConversa_Click" Margin="4,4,4,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="＋" FontSize="19" Margin="0,0,10,0"/>
                            <TextBlock x:Name="NewChatText" Text="Nova conversa" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="SettingsButton" Style="{StaticResource NavButton}"
                            Click="Configuracoes_Click" ToolTip="Configurações e integrações" Margin="4,4,4,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙" FontSize="17" Margin="0,0,10,0"/>
                            <TextBlock x:Name="SettingsText" Text="Configurações" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="2" Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid x:Name="TopBar" Margin="18,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="KAYRON" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="  ›  " Foreground="{StaticResource MutedBrush}" FontSize="16"/>
                        <TextBlock Text="AI Engineering" FontSize="14"
                                   Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button x:Name="ModelButton" Grid.Column="1" Content="IA / Plugins  ▾"
                            Click="Modelo_Click"/>
                </Grid>
            </Border>

            <ScrollViewer x:Name="ChatScroll" Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="MessagesPanel" Width="680" MaxWidth="680"
                            Margin="8,28,8,32" HorizontalAlignment="Center" MinWidth="280">
                    <StackPanel x:Name="WelcomePanel" HorizontalAlignment="Center"
                                Margin="0,70,0,35">
                        <Border Width="58" Height="58" CornerRadius="18"
                                Background="{StaticResource AccentBrush}" HorizontalAlignment="Center">
                            <TextBlock Text="K" FontSize="30" FontWeight="Bold"
                                       Foreground="White" HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Como posso ajudar?" FontSize="28" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,16,0,8"/>
                        <TextBlock Text="Analise projetos, encontre problemas e execute correções com segurança."
                                   FontSize="14" Foreground="{StaticResource MutedBrush}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1,1,1,0" Padding="20,12,20,16">
                <StackPanel x:Name="ComposerPanel" Width="680" MaxWidth="680"
                            HorizontalAlignment="Center">
                    <Border Background="{StaticResource InputBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="10">
                        <Grid Margin="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0">
                                <TextBox x:Name="InputBox" BorderThickness="0"
                                         Background="Transparent" MinHeight="42"
                                         Foreground="White" CaretBrush="White"
                                         VerticalContentAlignment="Center" AcceptsReturn="True"
                                         TextWrapping="Wrap" IsReadOnly="False" Focusable="True"
                                         KeyDown="InputBox_KeyDown" TextChanged="InputBox_TextChanged"
                                         GotFocus="InputBox_GotFocus" LostFocus="InputBox_LostFocus"/>
                                <TextBlock x:Name="InputPlaceholder" Text="Pergunte qualquer coisa"
                                           Foreground="White" Opacity="0.65" FontSize="14"
                                           VerticalAlignment="Center" Margin="12,0,8,0"
                                           IsHitTestVisible="False"/>
                            </Grid>
                            <Button x:Name="VoiceButton" Grid.Column="1" Style="{StaticResource SendButton}" Content="🎙" ToolTip="Ativar conversa por voz" AutomationProperties.Name="Ativar conversa por voz" Click="Voz_Click" Margin="8,0,0,0" MinWidth="48" MaxWidth="48"/>
                            <Button x:Name="SendButton" Grid.Column="2" Style="{StaticResource SendButton}" Content="Enviar  ›" ToolTip="Enviar mensagem (Enter)" AutomationProperties.Name="Enviar mensagem" Click="Enviar_Click" Margin="8,0,0,0" MinWidth="86" MaxWidth="86"/>
                        </Grid>
                    </Border>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,9,0,0">
                        <Ellipse x:Name="VoiceStatusDot" Width="9" Height="9" Fill="#77717D" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock x:Name="VoiceStatusText" Text="Voz desligada" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="KAYRON pode executar ações no projeto. Revise operações que alterem arquivos antes da confirmação."
                               Foreground="{StaticResource MutedBrush}" FontSize="10"
                               HorizontalAlignment="Center" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
